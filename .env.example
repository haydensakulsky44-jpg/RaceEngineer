# Copie ce fichier en ".env" et renseigne les vraies valeurs.
# Ne commite JAMAIS le fichier ".env" lui-même (déjà dans .gitignore).

# Clé API Anthropic (https://console.anthropic.com/) — pour le fallback LLM
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Clé secrète pour signer les tokens JWT d'authentification.
# Génère-en une avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplace-moi-par-une-valeur-aleatoire-longue

# URL de connexion PostgreSQL en production.
# Format : postgresql://utilisateur:motdepasse@hote:5432/nom_de_base
# Si non défini, l'app utilise un fichier SQLite local (data/raceengineer.db)
# automatiquement, pratique pour développer sans base PostgreSQL sous la main.
# DATABASE_URL=postgresql://user:password@host:5432/raceengineer

# URL du frontend en production, pour restreindre les appels API à ce
# domaine uniquement (CORS). Si non défini, l'API accepte les requêtes
# de n'importe quelle origine (pratique en dev, à restreindre en prod).
# FRONTEND_ORIGIN=https://raceengineer.app
